# Generates a header with the OpenCL and Metal program sources as byte arrays.
# Run in script mode:
#   cmake -DKERNEL_HEADER=... -DOPENCL_WRAPPERS=... -DMETAL_WRAPPERS=... -DOUTPUT=... -P EmbedKernels.cmake
# Byte arrays (rather than string literals) avoid MSVC's string literal length limit.

function(chromatron_bytes text out_var)
    string(HEX "${text}" hex)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n    " hex "${hex}")
    set(${out_var} "${hex}0x00" PARENT_SCOPE)
endfunction()

file(READ "${KERNEL_HEADER}" kernels)
file(READ "${OPENCL_WRAPPERS}" cl_wrappers)
file(READ "${METAL_WRAPPERS}" metal_wrappers)

chromatron_bytes("${kernels}\n${cl_wrappers}" cl_bytes)
chromatron_bytes("#include <metal_stdlib>\nusing namespace metal;\n${kernels}\n${metal_wrappers}" metal_bytes)

set(content "// Generated by cmake/EmbedKernels.cmake - do not edit.
#pragma once

static const unsigned char kChromatronOpenCLBytes[] = {
    ${cl_bytes}};

static const unsigned char kChromatronMetalBytes[] = {
    ${metal_bytes}};

#define kChromatronOpenCLSource (reinterpret_cast<const char*>(kChromatronOpenCLBytes))
#define kChromatronMetalSource (reinterpret_cast<const char*>(kChromatronMetalBytes))
")

# Only touch the file when it changes, so dependants are not rebuilt needlessly.
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
    if(previous STREQUAL content)
        return()
    endif()
endif()
file(WRITE "${OUTPUT}" "${content}")
